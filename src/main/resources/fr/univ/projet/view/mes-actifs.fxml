<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" styleClass="content-area" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.projet.controller.AssetsController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <HBox spacing="20.0">
        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="CASH DISPONIBLE" styleClass="card-title-small" style="-fx-text-fill: #94a3b8;"/>
            <Label fx:id="cashLabel" text="0.00 €" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="VALEUR TOTALE ACTIFS" styleClass="card-title-small" style="-fx-text-fill: #94a3b8;"/>
            <Label fx:id="assetsValueLabel" text="0.00 €" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>
    </HBox>

    <HBox spacing="25.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="chart-container">
            <Label text="Liste de vos actifs" style="-fx-font-size: 18; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <TableView fx:id="assetsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSymbol" text="Symbole" prefWidth="100"/>
                    <TableColumn fx:id="colName" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="colQty" text="Quantité" prefWidth="100"/>
                    <TableColumn fx:id="colPrice" text="Prix Unit." prefWidth="120"/>
                    <TableColumn fx:id="colValue" text="Valeur Totale" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="15.0" prefWidth="320.0" styleClass="buy-panel" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="Achat Rapide (Crypto)" style="-fx-font-size: 16; -fx-text-fill: white; -fx-font-weight: bold;"/>
            
            <Label text="Sélectionner Crypto" style="-fx-text-fill: #94a3b8;"/>
            <ComboBox fx:id="cryptoSelector" maxWidth="Infinity" />
            
            <Label text="Montant à investir (€)" style="-fx-text-fill: #94a3b8;"/>
            <TextField fx:id="amountField" promptText="Ex: 500" />
            
            <Separator opacity="0.1"/>
            <Label fx:id="previewLabel" text="Estimation : 0.00 units" style="-fx-text-fill: #38bdf8;"/>
            
            <Button fx:id="buyButton" text="CONFIRMER L'ACHAT" onAction="#handleBuyAction" maxWidth="Infinity" 
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </HBox>
</VBox>