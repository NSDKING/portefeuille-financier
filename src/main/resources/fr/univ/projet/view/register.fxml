<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="main-background" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.projet.controller.RegisterController">
    
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <VBox alignment="CENTER" spacing="5">
        <Label styleClass="app-title" text="Créer un compte" />
        <Label styleClass="register-subtitle" text="Configurez vos comptes sécurisés" />
    </VBox>

    <VBox maxWidth="400.0" spacing="15.0" styleClass="login-vbox">
        <padding>
            <Insets bottom="20" left="25" right="25" top="20" />
        </padding>

        <VBox spacing="8">
            <Label styleClass="section-subtitle" text="Identifiants" />
            <TextField fx:id="usernameField" promptText="Nom d'utilisateur" />
            <PasswordField fx:id="passwordField" promptText="Mot de passe" />
        </VBox>

        <VBox spacing="10">
            <Label styleClass="section-subtitle" text="Configuration Initiale" />
            <HBox spacing="10">
                <TextField fx:id="initialBalanceField" promptText="Solde initial (Courant)" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="currencyCombo" prefWidth="100.0" />
            </HBox>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 10; -fx-background-radius: 5;">
            <Label styleClass="section-subtitle" text="Comptes à activer :" />
            <CheckBox fx:id="checkCourant" disable="true" selected="true" text="Portefeuille Courant (Requis)" />
            <CheckBox fx:id="checkEpargne" text="Portefeuille Épargne" />
            <CheckBox fx:id="checkActions" text="Portefeuille Actions" />
            <CheckBox fx:id="checkCrypto" text="Portefeuille Crypto" />
        </VBox>
    </VBox>

    <VBox alignment="CENTER" spacing="15">
        <HBox alignment="CENTER" spacing="15.0">
            <Button onAction="#handleRegister" prefHeight="40.0" prefWidth="120.0" styleClass="refresh-button" text="S'inscrire" />
            <Button onAction="#handleBack" prefHeight="40.0" prefWidth="120.0" styleClass="button-secondary" text="Retour" />
        </HBox>
        <Label fx:id="errorLabel" styleClass="error-message" textAlignment="CENTER" wrapText="true" />
    </VBox>

</VBox>